{
  "schemaVersion": 1,
  "id": "animageddon",
  "version": "${version}",
  "name": "Animageddon",
  "description": "Overhaul of mobs while preserving the vanilla style of the game",
  "authors": ["ivangeevo"],
  "contact": {
    "repo": "https://github.com/ivangeevo/animageddon.git"
  },
  "license": "CC-BY 4.0",
  "icon": "assets/animageddon/icon.png",
  "environment": "*",
  "entrypoints": {
    "client": ["org.btwr.animageddon.AnimageddonModClient"],
    "main": ["org.btwr.animageddon.AnimageddonMod"],
    "fabric-datagen": ["org.btwr.animageddon.AnimageddonDataGenerator"]
  },
  "mixins": [
    "animageddon.mixins.json",
    {
      "config": "animageddon.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}",
    "btwr_sl": ">=${btwr_sl_version}"
  },
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/class_1297": ["org/btwr/animageddon/entity/interfaces/EntityAdded"],
      "net/minecraft/class_1428": ["org/btwr/animageddon/entity/interfaces/ChickenEntityAdded"],
      "net/minecraft/class_1429": ["org/btwr/animageddon/entity/interfaces/AnimalEntityAdded"],
      "net/minecraft/class_1430": ["org/btwr/animageddon/entity/interfaces/CowEntityAdded"],
      "net/minecraft/class_1477": ["org/btwr/animageddon/entity/interfaces/SquidEntityAdded"],
      "net/minecraft/class_1536": ["org/btwr/animageddon/item/interfaces/BaitableFishingRod"],
      "net/minecraft/class_1787": ["org/btwr/animageddon/item/interfaces/BaitableFishingRod"],
      "net/minecraft/class_1792": ["org/btwr/animageddon/item/interfaces/ItemAdded"]
    }
  },
  "accessWidener" : "animageddon.accesswidener"
}